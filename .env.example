# ---------------------------------------------------------------------------
# GROW — Environment Configuration Template
# Copy this file to `.env` for local development (`cp .env.example .env`).
# Never commit `.env` or production secrets to version control.
#
# Custom Path Note:
# By default, GROW loads `.env` from the project root (`BASE_DIR / ".env"`).
# In production, if your host allows setting non-secret environment variables
# in its UI, you can set `ENV_FILE=/custom/path/to/.env` (e.g., outside the web
# root for security) to override where this file is loaded from.
# ---------------------------------------------------------------------------

# Django Core Settings
# All security settings default to strict production mode (DEBUG=False).
# For local development, explicitly set DJANGO_DEBUG=True.
DJANGO_DEBUG=False
# Must be changed to a strong, unique secret key whenever DJANGO_DEBUG=False:
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF Trusted Origins (comma-separated, required in production for HTTPS POST requests):
# CSRF_TRUSTED_ORIGINS=https://example.com

# Database Configuration
# Options for DB_ENGINE: mariadb (default for dev & prod) | sqlite (fallback)
DB_ENGINE=mariadb
DB_NAME=grow
DB_USER=grow
DB_PASSWORD=growpassword
DB_ROOT_PASSWORD=growrootpassword  # Intended for MariaDB Docker container root password
DB_HOST=127.0.0.1
DB_PORT=3306

# Static Files Collection (Optional Override)
# Defaults to `staticfiles/` inside the project.
# In production on Passenger/cPanel where `public/` is the web document root,
# set this to `public/static` (or an absolute path) so `python manage.py collectstatic`
# outputs directly into the folder served by the web server:
# STATIC_ROOT=public/static
