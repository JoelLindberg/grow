# ---------------------------------------------------------------------------
# GROW — Environment Configuration Template
# Copy this file to `.env` for local development (`cp .env.example .env`).
# Never commit `.env` or production secrets to version control.
# ---------------------------------------------------------------------------

# Django Core Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Options for DB_ENGINE: mariadb (default for dev & prod) | sqlite (fallback)
DB_ENGINE=mariadb
DB_NAME=grow
DB_USER=grow
DB_PASSWORD=growpassword
DB_ROOT_PASSWORD=growrootpassword
DB_HOST=127.0.0.1
DB_PORT=3306

